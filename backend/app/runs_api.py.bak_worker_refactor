def _run_real_optimizer_once(log_path: Path) -> Path:
    """
    Runs the real optimizer script and returns the produced theta_latest.pt path.
    Current bridge uses smoke_joint_opt_fast as the live engine source.
    """
    with log_path.open("a") as f:
        f.write("[RUN_ENGINE] invoking scripts.smoke_joint_opt_fast.main()\n")

    smoke_joint_opt_fast_main()

    theta_latest = Path("/workspaces/lpbf_project/scripts/theta_latest.pt")
    if not theta_latest.exists():
        raise RuntimeError(f"Real optimizer did not produce theta_latest.pt at {theta_latest}")

    return theta_latest



