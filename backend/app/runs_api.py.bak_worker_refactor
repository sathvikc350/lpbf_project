def _connect() -> sqlite3.Connection:
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(str(DB_PATH), timeout=5.0)
    con.row_factory = sqlite3.Row
    return con


def _read_text_or_none(p: Path) -> Optional[str]:
    try:
        return p.read_text().strip()
    except Exception:
        return None


def _ph4_ids() -> Dict[str, str]:
    lock_id = _read_text_or_none(PH4_DIR / "PHASE4_LOCK_ID.txt")
    core_id = _read_text_or_none(PH4_DIR / "PHASE4_CORE_FREEZE_ID.txt")
    if not lock_id or not core_id:
        raise HTTPException(
            status_code=500,
            detail=(
                "PH4 IDs missing. Expected PHASE4_LOCK_ID.txt and "
                f"PHASE4_CORE_FREEZE_ID.txt under {PH4_DIR}"
            ),
        )
    return {"lock_id": lock_id, "core_freeze_id": core_id}


def _ensure_run_dirs(run_dir: Path) -> None:
    subdirs = ["inputs", "checkpoints", "exports", "reports", "logs"]
    run_dir.mkdir(parents=True, exist_ok=False)
    for sd in subdirs:
        (run_dir / sd).mkdir(parents=True, exist_ok=False)


def _write_json(path: Path, data: Any) -> None:
    path.write_text(json.dumps(data, indent=2))


def _get_run_row(con: sqlite3.Connection, run_id: str) -> sqlite3.Row:
    row = con.execute(
        """
        SELECT run_id, name, status, created_unix_s, updated_unix_s,
               material, voxel_size_mm, probe_mode,
               ph4_dir, lock_id, core_freeze_id, run_dir,
               last_iter, total_iters, warnings_json, error_text,
               control_state, paused_at_unix_s, stop_reason
        FROM runs
        WHERE run_id=?
        """,
        (run_id,),
    ).fetchone()
    if row is None:
        raise HTTPException(status_code=404, detail="Run not found")
    return row


def _get_run_dir(con: sqlite3.Connection, run_id: str) -> Path:
    row = con.execute("SELECT run_dir FROM runs WHERE run_id=?", (run_id,)).fetchone()
    if row is None:
        raise HTTPException(status_code=404, detail="Run not found")
    return Path(row["run_dir"])


