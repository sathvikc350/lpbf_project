def _set_control_state(
    run_id: str,
    state: str,
    *,
    reason: Optional[str] = None,
    overwrite_reason: bool = False,
) -> None:
    state_u = (state or "RUNNING").strip().upper()
    now = time.time()
    con = _connect()
    try:
        if overwrite_reason:
            con.execute(
                """
                UPDATE runs
                SET control_state=?, updated_unix_s=?, stop_reason=?
                WHERE run_id=?
                """,
                (state_u, now, reason, run_id),
            )
        else:
            con.execute(
                """
                UPDATE runs
                SET control_state=?, updated_unix_s=?, stop_reason=COALESCE(?, stop_reason)
                WHERE run_id=?
                """,
                (state_u, now, reason, run_id),
            )
        con.commit()
    finally:
        con.close()


def _finalize_run_terminal(
    run_id: str,
    terminal_status: str,
    *,
    reason: Optional[str] = None,
    error_text: Optional[str] = None,
) -> None:
    terminal_status = (terminal_status or "").strip().upper()
    if terminal_status not in ("DONE", "FAILED", "STOPPED"):
        raise ValueError(f"terminal_status must be DONE/FAILED/STOPPED, got: {terminal_status}")

    now = time.time()
    con = _connect()
    try:
        con.execute(
            """
            UPDATE runs
            SET status=?,
                control_state='IDLE',
                paused_at_unix_s=NULL,
                updated_unix_s=?,
                stop_reason=COALESCE(?, stop_reason),
                error_text=COALESCE(?, error_text)
            WHERE run_id=?
            """,
            (terminal_status, now, reason, error_text, run_id),
        )
        con.commit()
    finally:
        con.close()


def _clear_start_leftovers(run_id: str) -> None:
    now = time.time()
    con = _connect()
    try:
        con.execute(
            """
            UPDATE runs
            SET paused_at_unix_s=NULL,
                stop_reason=NULL,
                error_text=NULL,
                updated_unix_s=?,
                control_state='RUNNING'
            WHERE run_id=?
            """,
            (now, run_id),
        )
        con.commit()
    finally:
        con.close()


