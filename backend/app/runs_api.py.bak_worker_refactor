@router.post("", response_model=RunCreateResponse)
def create_run(req: RunCreateRequest) -> RunCreateResponse:
    if not PH4_DIR.exists():
        raise HTTPException(status_code=500, detail=f"PH4_DIR not found: {PH4_DIR}")
    ids = _ph4_ids()

    run_id = f"run_{time.strftime('%Y%m%d_%H%M%S')}_{uuid.uuid4().hex[:8]}"
    run_dir = RUNS_ROOT / run_id
    RUNS_ROOT.mkdir(parents=True, exist_ok=True)

    try:
        _ensure_run_dirs(run_dir)
    except FileExistsError:
        raise HTTPException(status_code=409, detail="Run dir already exists. Retry.")
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to create run dirs: {e}")

    created = time.time()
    status = "CREATED"

    _write_json(
        run_dir / "inputs" / "run_meta.json",
        {
            "run_id": run_id,
            "name": req.name,
            "notes": req.notes,
            "created_unix_s": created,
            "status": status,
            "material": req.material,
            "voxel_size_mm": req.voxel_size_mm,
            "probe_mode": req.probe_mode,
            "ph4_dir": str(PH4_DIR),
            "lock_id": ids["lock_id"],
            "core_freeze_id": ids["core_freeze_id"],
        },
    )

    con = _connect()
    try:
        sql = """
        INSERT INTO runs(
            run_id, name, status, created_unix_s, updated_unix_s,
            material, voxel_size_mm, probe_mode,
            ph4_dir, lock_id, core_freeze_id,
            run_dir, last_iter, total_iters, warnings_json, error_text,
            control_state, paused_at_unix_s, stop_reason
        )
        VALUES(?,?,?,?,?,
               ?,?,?, 
               ?,?,?, 
               ?,?,?,?,?, 
               ?,?,?)
        """
        values = (
            run_id,
            req.name,
            status,
            created,
            created,
            req.material,
            req.voxel_size_mm,
            req.probe_mode,
            str(PH4_DIR),
            ids["lock_id"],
            ids["core_freeze_id"],
            str(run_dir),
            0,
            0,
            "[]",
            None,
            "IDLE",
            None,
            None,
        )
        con.execute(sql, values)
        con.commit()
    finally:
        con.close()

    return RunCreateResponse(
        run_id=run_id,
        run_dir=str(run_dir),
        created_unix_s=created,
        ph4_dir=str(PH4_DIR),
        lock_id=ids["lock_id"],
        core_freeze_id=ids["core_freeze_id"],
    )


@router.post("/{run_id}/clone")
def clone_run(run_id: str):
    ids = _ph4_ids()

    con = _connect()
    try:
        src = _get_run_row(con, run_id)
        src_dir = Path(src["run_dir"])
    finally:
        con.close()

    new_run_id = f"run_{time.strftime('%Y%m%d_%H%M%S')}_{uuid.uuid4().hex[:8]}"
    new_dir = RUNS_ROOT / new_run_id
    RUNS_ROOT.mkdir(parents=True, exist_ok=True)
    _ensure_run_dirs(new_dir)

    src_inputs = src_dir / "inputs"
    dst_inputs = new_dir / "inputs"
    for p in src_inputs.glob("*"):
        if p.is_file():
            shutil.copy2(str(p), str(dst_inputs / p.name))

    meta_p = dst_inputs / "run_meta.json"
    meta = {}
    if meta_p.exists():
        try:
            meta = json.loads(meta_p.read_text())
        except Exception:
            meta = {}
    meta.update(
        {
            "run_id": new_run_id,
            "created_unix_s": time.time(),
            "status": "CREATED",
            "ph4_dir": str(PH4_DIR),
            "lock_id": ids["lock_id"],
            "core_freeze_id": ids["core_freeze_id"],
        }
    )
    _write_json(meta_p, meta)

    con = _connect()
    try:
        created = time.time()
        sql = """
        INSERT INTO runs(
            run_id, name, status, created_unix_s, updated_unix_s,
            material, voxel_size_mm, probe_mode,
            ph4_dir, lock_id, core_freeze_id,
