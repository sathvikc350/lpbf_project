@router.post("/{run_id}/inputs/geometry_upload")
async def geometry_upload(run_id: str, file: UploadFile = File(...)):
    fn = (file.filename or "").lower()
    if not (
        fn.endswith(".stl")
        or file.content_type in ("model/stl", "application/sla", "application/octet-stream", None)
    ):
        raise HTTPException(status_code=400, detail="Only STL upload is supported in v1 (file must end with .stl).")

    con = _connect()
    try:
        run_dir = _get_run_dir(con, run_id)
    finally:
        con.close()

    inputs_dir = run_dir / "inputs"
    inputs_dir.mkdir(parents=True, exist_ok=True)

    stl_path = inputs_dir / "geometry.stl"
    data = await file.read()
    if not data or len(data) < 64:
        raise HTTPException(status_code=400, detail="Empty/invalid STL upload.")
    stl_path.write_bytes(data)

    try:
        import trimesh

        m_any = trimesh.load(str(stl_path), force="mesh")
        if not isinstance(m_any, trimesh.Trimesh):
            raise RuntimeError("Upload did not parse as a mesh.")
        bounds = m_any.bounds
        min_xyz = [float(bounds[0][0]), float(bounds[0][1]), float(bounds[0][2])]
        max_xyz = [float(bounds[1][0]), float(bounds[1][1]), float(bounds[1][2])]
        dims = [max_xyz[i] - min_xyz[i] for i in range(3)]
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Failed to parse STL: {e}")

    voxel_size_mm = _get_voxel_size_mm_from_run(run_dir)
    nx = int(math.ceil(dims[0] / voxel_size_mm)) if voxel_size_mm > 0 else 0
    ny = int(math.ceil(dims[1] / voxel_size_mm)) if voxel_size_mm > 0 else 0
    nz = int(math.ceil(dims[2] / voxel_size_mm)) if voxel_size_mm > 0 else 0
    fits_cap = nx <= 128 and ny <= 128 and nz <= 128
    largest_dim = max(dims) if dims else 0.0
    suggested_voxel = round(largest_dim / 128.0, 4) if largest_dim > 0 else voxel_size_mm

    geom_meta = {
        "filename": file.filename,
        "stored_path": str(stl_path),
        "bbox_mm": {"min": min_xyz, "max": max_xyz},
        "dims_mm": dims,
        "voxel_size_mm_used": voxel_size_mm,
        "grid_estimate": [nx, ny, nz],
        "fits_128_cubed": fits_cap,
        "suggested_voxel_size_mm": suggested_voxel,
    }
    _write_json(inputs_dir / "geometry_meta.json", geom_meta)

    con = _connect()
    try:
        _touch_updated(con, run_id)
        con.commit()
    finally:
        con.close()

    return {"ok": True, **geom_meta}


@router.post("/{run_id}/inputs/domain_cube")
def set_domain_cube(run_id: str, req: DomainCubeRequest):
    nx = int(req.x_mm // req.voxel_size_mm)
    ny = int(req.y_mm // req.voxel_size_mm)
    nz = int(req.z_mm // req.voxel_size_mm)

    if nx <= 0 or ny <= 0 or nz <= 0:
        raise HTTPException(status_code=400, detail="Invalid dimensions/voxel_size: resulted in non-positive grid.")

    cap = 128
    if max(nx, ny, nz) > cap:
        raise HTTPException(
            status_code=400,
            detail=f"Domain too large for v1 cap {cap}^3. Got grid=({nx},{ny},{nz}). Increase voxel_size or reduce mm dims.",
        )

    con = _connect()
    try:
        run_dir = _get_run_dir(con, run_id)
        inputs_dir = run_dir / "inputs"
        inputs_dir.mkdir(parents=True, exist_ok=True)

        domain = {
            "preset": "cube",
            "units": "mm",
            "voxel_size_mm": float(req.voxel_size_mm),
            "grid": {"nx": nx, "ny": ny, "nz": nz},
            "build_direction": "+Z",
            "supports": [
                {
                    "type": "box",
                    "name": "fixed_x0_plane",
                    "bounds_ijk": {"i": [0, 1], "j": [0, ny], "k": [0, nz]},
                }
            ],
            "loads": [
                {
                    "type": "box",
                    "name": "tip_down_force",
                    "bounds_ijk": {
                        "i": [max(nx - 8, 0), nx],
                        "j": [int(0.44 * ny), int(0.56 * ny)],
                        "k": [int(0.44 * nz), int(0.56 * nz)],
                    },
                    "force": {"fx": 0.0, "fy": 0.0, "fz": -1.0},
                    "magnitude": 1.0,
                    "units_force": "arb",
                }
            ],
            "notes": "v1 cube domain generated from mm dims; build dir locked +Z; default cantilever rule.",
        }

        out_path = inputs_dir / "domain.json"
        _write_json(out_path, domain)

        meta_p = inputs_dir / "run_meta.json"
        if meta_p.exists():
            try:
                meta = json.loads(meta_p.read_text())
                meta["voxel_size_mm"] = float(req.voxel_size_mm)
                _write_json(meta_p, meta)
            except Exception:
                pass

        _touch_updated(con, run_id)
        con.commit()
        return {
            "ok": True,
            "path": str(out_path),
            "grid": [nx, ny, nz],
            "voxel_size_mm": float(req.voxel_size_mm),
        }
    finally:
        con.close()


