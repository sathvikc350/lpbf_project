        raise HTTPException(status_code=409, detail=f"Can only pause a RUNNING run (current={cur})")

    reason = (req.reason or "pause requested").strip()
    _set_control_state(run_id, "PAUSE_REQUESTED", reason=reason, overwrite_reason=True)
    return {"ok": True, "run_id": run_id, "control_state": "PAUSE_REQUESTED"}


@router.post("/{run_id}/resume")
def resume_run(run_id: str):
    st = _get_status_control(run_id)
    cur = (st.get("status") or "").upper()
    if cur != "PAUSED":
        raise HTTPException(status_code=409, detail=f"Can only resume a PAUSED run (current={cur})")

    _set_control_state(run_id, "RUNNING", reason=None, overwrite_reason=True)

    con = _connect()
    try:
        now = time.time()
        con.execute(
            "UPDATE runs SET status=?, updated_unix_s=?, paused_at_unix_s=NULL WHERE run_id=?",
            ("RUNNING", now, run_id),
        )
        con.commit()
    finally:
        con.close()

    return {"ok": True, "run_id": run_id, "control_state": "RUNNING"}


@router.post("/{run_id}/stop")
def stop_run(run_id: str, req: ControlRequest = ControlRequest()):
    st = _get_status_control(run_id)
    cur = (st.get("status") or "").upper()
    if cur not in ("RUNNING", "PAUSED"):
        raise HTTPException(status_code=409, detail=f"Can only stop a RUNNING/PAUSED run (current={cur})")

    reason = (req.reason or "stop requested").strip()
    _set_control_state(run_id, "STOP_REQUESTED", reason=reason, overwrite_reason=True)
    return {"ok": True, "run_id": run_id, "control_state": "STOP_REQUESTED"}


# -----------------------------
# Runner + start endpoint
# -----------------------------
def _runner_stub(run_id: str, run_dir: Path) -> None:
    def _get_ctl() -> str:
        con = _connect()
        try:
            row = con.execute("SELECT control_state, stop_reason FROM runs WHERE run_id=?", (run_id,)).fetchone()
            if row is None:
                return "STOP_REQUESTED"
            s = row["control_state"] or "RUNNING"
            return str(s).strip().upper()
        finally:
            con.close()

    def _mark_paused_once() -> None:
        con = _connect()
        try:
            now = time.time()
            con.execute(
                """
                UPDATE runs
                SET status=?, updated_unix_s=?, paused_at_unix_s=?
                WHERE run_id=?
                """,
                ("PAUSED", now, now, run_id),
            )
            con.commit()
        finally:
            con.close()

    try:
        _update_run_status(run_id, "RUNNING", error_text=None)

        payload = _read_required_inputs(run_dir)
        opt = payload["opt"]
        total_iters = int(opt.get("total_iters", 200))
        snap_every = int(opt.get("snapshot_every", 10))
        iso_threshold = float(opt.get("iso_threshold", 0.525))

        logs_dir = run_dir / "logs"
        logs_dir.mkdir(parents=True, exist_ok=True)
        log_path = logs_dir / "run.log"
        with log_path.open("a") as f:
            f.write(f"[RUN_START] run_id={run_id} total_iters={total_iters} snapshot_every={snap_every}\n")

        theta_phys_path = _run_real_optimizer_once(log_path)
        theta_phys = _safe_torch_load_tensor(theta_phys_path)

        with log_path.open("a") as f:
            f.write(f"[RUN_ENGINE_DONE] theta_source={theta_phys_path}\n")

        _set_control_state(run_id, "RUNNING", reason=None, overwrite_reason=False)

        for it in range(1, total_iters + 1):
            ctl = _get_ctl()

            if ctl == "STOP_REQUESTED":
                with log_path.open("a") as f:
                    f.write(f"[RUN_STOPPED] run_id={run_id} at_iter={it}\n")
                st = _get_status_control(run_id)
                reason = st.get("stop_reason") or "stop requested"
                _finalize_run_terminal(run_id, "STOPPED", reason=reason)
                return

            if ctl == "PAUSE_REQUESTED":
                _mark_paused_once()
                with log_path.open("a") as f:
                    f.write(f"[RUN_PAUSED] run_id={run_id} at_iter={it}\n")
                while True:
                    ctl2 = _get_ctl()
                    if ctl2 == "STOP_REQUESTED":
                        with log_path.open("a") as f:
                            f.write(f"[RUN_STOPPED] run_id={run_id} while_paused at_iter={it}\n")
                        st = _get_status_control(run_id)
                        reason = st.get("stop_reason") or "stop requested"
                        _finalize_run_terminal(run_id, "STOPPED", reason=reason)
                        return
                    if ctl2 == "RUNNING":
                        con = _connect()
                        try:
                            now = time.time()
                            con.execute(
                                "UPDATE runs SET status=?, updated_unix_s=?, paused_at_unix_s=NULL WHERE run_id=?",
                                ("RUNNING", now, run_id),
                            )
                            con.commit()
                        finally:
                            con.close()
                        with log_path.open("a") as f:
                            f.write(f"[RUN_RESUMED] run_id={run_id} at_iter={it}\n")
                        break
                    time.sleep(0.25)

            if (it % snap_every) == 0 or it == total_iters:
                write_checkpoint(run_id=run_id, run_dir=run_dir, it=it, theta_phys=theta_phys)

                vtp_path = _export_physics_manifest_vtp(
                    run_dir=run_dir,
                    it=it,
                    iso_threshold=iso_threshold,
                )
                with log_path.open("a") as f:
                    f.write(f"[RUN_EXPORT_VTP] iter={it} path={vtp_path.name}\n")

                voxel_size_mm = _get_voxel_size_mm_from_run(run_dir)
                theta_path = run_dir / "checkpoints" / f"theta_phys_iter_{int(it):06d}.pt"
                theta = _safe_torch_load_tensor(theta_path)

                prev_dir = run_dir / "exports" / "preview"
                prev_dir.mkdir(parents=True, exist_ok=True)
                prev_stl = prev_dir / f"preview_iter_{int(it):06d}_lvl_{iso_threshold:.3f}.stl"
                if not prev_stl.exists():
                    _theta_tensor_to_stl(theta, prev_stl, voxel_size_mm=voxel_size_mm, level=iso_threshold)

                wt_dir = run_dir / "exports" / "preview_watertight"
                wt_dir.mkdir(parents=True, exist_ok=True)
                wt_stl = wt_dir / f"preview_watertight_iter_{int(it):06d}_lvl_{iso_threshold:.3f}_pitch_0.250.stl"
                if not wt_stl.exists():
                    _theta_tensor_to_watertight_stl_from_volume(
                        theta,
                        wt_stl,
                        voxel_size_mm=voxel_size_mm,
                        level=iso_threshold,
                        cleanup=True,
                    )

            _update_run_progress(run_id, it)
            time.sleep(0.01)

        with log_path.open("a") as f:
            f.write(f"[RUN_DONE] run_id={run_id}\n")
        _finalize_run_terminal(run_id, "DONE", reason=None)

        try:
            _write_summary_json(run_id, run_dir)
        except Exception:
            pass

        return

    except Exception as e:
        tb = traceback.format_exc()
        try:
            (run_dir / "logs").mkdir(parents=True, exist_ok=True)
            (run_dir / "logs" / "run_error.txt").write_text(tb)
        except Exception:
            pass
        _finalize_run_terminal(run_id, "FAILED", reason=None, error_text=str(e))


@router.post("/{run_id}/start", response_model=RunStartResponse)
def start_run(run_id: str) -> RunStartResponse:
    con = _connect()
    try:
        row = con.execute("SELECT run_id, status, run_dir FROM runs WHERE run_id=?", (run_id,)).fetchone()
        if row is None:
            raise HTTPException(status_code=404, detail="Run not found")

        status = (row["status"] or "").upper()
        run_dir = Path(row["run_dir"])

        if status in ("RUNNING", "PAUSED"):
            raise HTTPException(status_code=409, detail=f"Run is already active (current={status})")
        if status in ("DONE", "STOPPED"):
            raise HTTPException(status_code=409, detail=f"Run is terminal (current={status})")

        try:
            _read_required_inputs(run_dir)
        except Exception as e:
            _set_control_state(run_id, "IDLE", reason=str(e), overwrite_reason=True)
            raise HTTPException(status_code=400, detail=str(e))

        _clear_start_leftovers(run_id)
        _update_run_status(run_id, "QUEUED", error_text=None)

        t = threading.Thread(target=_runner_stub, args=(run_id, run_dir), daemon=True)
        t.start()

        return RunStartResponse(run_id=run_id, status="QUEUED")
    finally:
        con.close()
