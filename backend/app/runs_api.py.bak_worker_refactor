def _sha256_file(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def _manifest_list_files(*, run_id: str, kind: str, root: Path, include_sha256: bool) -> List[Dict[str, Any]]:
    items: List[Dict[str, Any]] = []
    if not root.exists():
        return items

    files = sorted([p for p in root.rglob("*") if p.is_file()], key=lambda p: p.relative_to(root).as_posix())
    for p in files:
        rel = p.relative_to(root).as_posix()
        st = p.stat()
        entry: Dict[str, Any] = {
            "kind": kind,
            "path": str(p),
            "rel": rel,
            "bytes": int(st.st_size),
            "mtime_unix_s": float(st.st_mtime),
            "download_url": f"/runs/{run_id}/artifacts/download/{kind}/{rel}",
        }
        if include_sha256:
            try:
                entry["sha256"] = _sha256_file(p)
            except Exception as e:
                entry["sha256"] = None
                entry["sha256_error"] = str(e)
        items.append(entry)
    return items


