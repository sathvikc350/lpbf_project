def _artifact_base_dir(run_dir: Path, kind: str) -> Path:
    k = (kind or "").strip().lower()
    if k == "inputs":
        return run_dir / "inputs"
    if k == "checkpoints":
        return run_dir / "checkpoints"
    if k == "exports":
        return run_dir / "exports"
    if k == "reports":
        return run_dir / "reports"
    if k == "logs":
        return run_dir / "logs"
    raise HTTPException(status_code=400, detail=f"Unknown artifact kind '{kind}'")


def _safe_resolve_under(base: Path, rel_path: str) -> Path:
    base_resolved = base.resolve()
    candidate = (base_resolved / rel_path).resolve()
    try:
        candidate.relative_to(base_resolved)
    except Exception:
        raise HTTPException(status_code=400, detail="Invalid rel_path (path traversal not allowed)")
    return candidate


@router.get("/{run_id}/artifacts/download/{kind}/{rel_path:path}")
def download_artifact(run_id: str, kind: str, rel_path: str):
    con = _connect()
    try:
        run_dir = _get_run_dir(con, run_id)
    finally:
        con.close()

    base = _artifact_base_dir(run_dir, kind)
    target = _safe_resolve_under(base, rel_path)

    if not target.exists() or not target.is_file():
        raise HTTPException(status_code=404, detail=f"Artifact not found: {kind}/{rel_path}")

    media_type, _ = mimetypes.guess_type(str(target))
    if media_type is None:
        media_type = "application/octet-stream"
    return FileResponse(path=str(target), media_type=media_type, filename=target.name)


