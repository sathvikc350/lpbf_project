def _write_summary_json(run_id: str, run_dir: Path) -> Path:
    con = _connect()
    try:
        row = _get_run_row(con, run_id)
        run = dict(row)
    finally:
        con.close()

    iters = _checkpoint_iters(run_dir)
    latest_it = iters[-1] if iters else None

    inputs_dir = run_dir / "inputs"
    domain = json.loads((inputs_dir / "domain.json").read_text()) if (inputs_dir / "domain.json").exists() else None
    process = json.loads((inputs_dir / "process.json").read_text()) if (inputs_dir / "process.json").exists() else None
    opt = json.loads((inputs_dir / "opt_config.json").read_text()) if (inputs_dir / "opt_config.json").exists() else None

    exports_dir = run_dir / "exports"
    physics_files = sorted((exports_dir / "physics").glob("physics_manifest_iter_*.vtp")) if (exports_dir / "physics").exists() else []
    preview_files = sorted((exports_dir / "preview").glob("preview_iter_*.stl")) if (exports_dir / "preview").exists() else []
    wt_files = sorted((exports_dir / "preview_watertight").glob("preview_watertight_iter_*.stl")) if (exports_dir / "preview_watertight").exists() else []

    out = {
        "schema": "summary_v1",
        "run": run,
        "latest_checkpoint_iter": latest_it,
        "domain": domain,
        "process": process,
        "opt_config": opt,
        "exports": {
            "physics_vtp_latest": physics_files[-1].name if physics_files else None,
            "preview_stl_latest": preview_files[-1].name if preview_files else None,
            "watertight_stl_latest": wt_files[-1].name if wt_files else None,
        },
        "generated_unix_s": time.time(),
    }

    reports_dir = run_dir / "reports"
    reports_dir.mkdir(parents=True, exist_ok=True)
    p = reports_dir / "summary.json"
    _write_json(p, out)
    return p


