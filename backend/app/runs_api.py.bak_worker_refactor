def _checkpoint_iters(run_dir: Path) -> List[int]:
    ckpt_dir = run_dir / "checkpoints"
    if not ckpt_dir.exists():
        return []
    iters: List[int] = []
    for p in ckpt_dir.glob("theta_phys_iter_*.pt"):
        m = re.search(r"theta_phys_iter_(\d{6})\.pt$", p.name)
        if m:
            iters.append(int(m.group(1)))
    if iters:
        return sorted(set(iters))
    for p in ckpt_dir.glob("checkpoint_iter_*.json"):
        m = re.search(r"checkpoint_iter_(\d{6})\.json$", p.name)
        if m:
            iters.append(int(m.group(1)))
    return sorted(set(iters))


@router.get("/{run_id}/checkpoints")
def list_checkpoints(run_id: str):
    con = _connect()
    try:
        run_dir = _get_run_dir(con, run_id)
    finally:
        con.close()

    ckpt_dir = run_dir / "checkpoints"
    if not ckpt_dir.exists():
        raise HTTPException(status_code=404, detail="checkpoints dir not found")

    pat = re.compile(r"theta_phys_iter_(\d{6})\.pt$")
    items = []
    for p in sorted(ckpt_dir.glob("theta_phys_iter_*.pt")):
        m = pat.search(p.name)
        if not m:
            continue
        it = int(m.group(1))
        meta = ckpt_dir / f"checkpoint_iter_{it:06d}.json"
        items.append({"iter": it, "theta_pt": str(p), "meta_json": str(meta) if meta.exists() else None})

    return {
        "ok": True,
        "run_id": run_id,
        "num": len(items),
        "iters": [x["iter"] for x in items],
        "items": items,
        "latest": items[-1] if items else None,
    }


