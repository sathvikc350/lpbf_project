def _read_required_inputs(run_dir: Path) -> Dict[str, Any]:
    inputs_dir = run_dir / "inputs"
    domain_path = inputs_dir / "domain.json"
    process_path = inputs_dir / "process.json"
    opt_path = inputs_dir / "opt_config.json"

    missing = [p.name for p in [domain_path, process_path, opt_path] if not p.exists()]
    if missing:
        raise RuntimeError(f"Missing required inputs: {missing}")

    domain = json.loads(domain_path.read_text())
    process = json.loads(process_path.read_text())
    opt = json.loads(opt_path.read_text())
    return {"domain": domain, "process": process, "opt": opt}


def _safe_torch_load_tensor(path: Path) -> torch.Tensor:
    try:
        obj = torch.load(str(path), map_location="cpu", weights_only=True)  # type: ignore[arg-type]
    except TypeError:
        obj = torch.load(str(path), map_location="cpu")
    if not isinstance(obj, torch.Tensor):
        raise RuntimeError(f"{path} did not contain a torch.Tensor")
    return obj.float()


def _get_voxel_size_mm_from_run(run_dir: Path) -> float:
    try:
        p = run_dir / "inputs" / "run_meta.json"
        if p.exists():
            meta = json.loads(p.read_text())
            v = meta.get("voxel_size_mm")
            if isinstance(v, (int, float)) and v > 0:
                return float(v)
    except Exception:
        pass
    return 0.5


def _theta_to_numpy_grid(theta: torch.Tensor) -> np.ndarray:
    t = theta
    if t.ndim == 4 and t.shape[0] == 1:
        t = t[0]
    if t.ndim != 3:
        raise RuntimeError(f"Expected theta to be 3D (or 1x3D). Got shape {tuple(theta.shape)}")
    return t.detach().cpu().float().numpy()


def _sample_grid_to_surface_points(
    grid: np.ndarray,
    pts_xyz_mm: np.ndarray,
    voxel_size_mm: float,
) -> np.ndarray:
    if voxel_size_mm <= 0:
        raise RuntimeError(f"voxel_size_mm must be > 0, got {voxel_size_mm}")

    ijk = np.rint(pts_xyz_mm / float(voxel_size_mm)).astype(np.int64)
    ijk[:, 0] = np.clip(ijk[:, 0], 0, grid.shape[0] - 1)
    ijk[:, 1] = np.clip(ijk[:, 1], 0, grid.shape[1] - 1)
    ijk[:, 2] = np.clip(ijk[:, 2], 0, grid.shape[2] - 1)
    return grid[ijk[:, 0], ijk[:, 1], ijk[:, 2]]


def _make_surface_from_voxels(phi: np.ndarray, *, level: float, voxel_size_mm: float):
    import pyvista as pv

    try:
        from skimage import measure

        verts, faces, _normals, _values = measure.marching_cubes(
            phi,
            level=float(level),
            spacing=(float(voxel_size_mm), float(voxel_size_mm), float(voxel_size_mm)),
        )
        faces_pv = np.hstack(
            [np.full((faces.shape[0], 1), 3, dtype=np.int64), faces.astype(np.int64)]
        ).ravel()
        mesh = pv.PolyData(verts, faces_pv)
        mesh.compute_normals(point_normals=True, cell_normals=False, inplace=True)
        return mesh
    except Exception:
        grid = pv.ImageData()
        nx, ny, nz = phi.shape
        grid.dimensions = (nx, ny, nz)
        grid.spacing = (float(voxel_size_mm), float(voxel_size_mm), float(voxel_size_mm))
        grid.origin = (0.0, 0.0, 0.0)
        grid.point_data["theta"] = phi.astype(np.float32).ravel(order="F")

        mesh = grid.contour(
            isosurfaces=1,
            rng=[float(level), float(level)],
            scalars="theta",
        )
        if mesh is None or mesh.n_points == 0:
            raise RuntimeError(f"No surface extracted. Try lowering iso threshold (level={level}).")
        mesh.compute_normals(point_normals=True, cell_normals=False, inplace=True)
        return mesh


def _get_process_param(process: Dict[str, Any], *keys: str) -> Optional[float]:
    candidates: List[Dict[str, Any]] = []
    if isinstance(process, dict):
        candidates.append(process)
        params = process.get("params")
        if isinstance(params, dict):
            candidates.append(params)

    for src in candidates:
        for k in keys:
            if k in src and src[k] is not None:
                try:
                    return float(src[k])
                except Exception:
                    pass
    return None


# -----------------------------
# Watertight STL from volume
# -----------------------------
def _theta_tensor_to_watertight_stl_from_volume(
    theta: torch.Tensor,
    out_stl: Path,
    *,
    voxel_size_mm: float,
    level: float,
    cleanup: bool = True,
) -> None:
    import trimesh

    arr = _theta_to_numpy_grid(theta)
    vol = arr > float(level)

    if cleanup:
        try:
            from skimage.morphology import remove_small_objects, binary_closing, ball

            vol = binary_closing(vol, ball(1))
            vol = remove_small_objects(vol, min_size=64)
        except Exception:
            pass

    transform = trimesh.transformations.scale_matrix(float(voxel_size_mm))
    vg = trimesh.voxel.VoxelGrid(vol, transform=transform)

    try:
        vg = vg.fill()
    except Exception:
        try:
            vg.fill()
        except Exception:
            pass

    mesh = vg.marching_cubes

    try:
        mesh.update_faces(mesh.nondegenerate_faces())
    except Exception:
        pass
    try:
        mesh.remove_unreferenced_vertices()
    except Exception:
        pass

    out_stl.parent.mkdir(parents=True, exist_ok=True)
    mesh.export(str(out_stl))


def _export_physics_manifest_vtp(
    *,
    run_dir: Path,
    it: int,
    iso_threshold: float,
    overhang_angle_deg: float = 45.0,
) -> Path:
    import pyvista as pv  # noqa: F401

    ckpt_dir = run_dir / "checkpoints"
    inputs_dir = run_dir / "inputs"
    out_dir = run_dir / "exports" / "physics"
    out_dir.mkdir(parents=True, exist_ok=True)

    theta_path = ckpt_dir / f"theta_phys_iter_{int(it):06d}.pt"
    if not theta_path.exists():
        raise RuntimeError(f"Missing checkpoint tensor for VTP export: {theta_path}")

    process_path = inputs_dir / "process.json"
    process: Dict[str, Any] = json.loads(process_path.read_text()) if process_path.exists() else {}

    voxel_size_mm = _get_voxel_size_mm_from_run(run_dir)
    theta = _safe_torch_load_tensor(theta_path)
    theta_np = _theta_to_numpy_grid(theta)

    mesh = _make_surface_from_voxels(
        theta_np,
        level=float(iso_threshold),
        voxel_size_mm=float(voxel_size_mm),
    )
    if mesh is None or mesh.n_points == 0:
        raise RuntimeError(f"Empty mesh produced for iter={it} iso={iso_threshold}")

    pts = np.asarray(mesh.points, dtype=np.float32)

    mesh["theta"] = _sample_grid_to_surface_points(
        theta_np,
        pts,
        float(voxel_size_mm),
    ).astype(np.float32)

    if "Normals" not in mesh.point_data:
        mesh.compute_normals(point_normals=True, cell_normals=False, inplace=True)

    normals = np.asarray(mesh.point_data["Normals"], dtype=np.float32)
    nz = normals[:, 2]
    crit_cos = float(np.cos(np.deg2rad(float(overhang_angle_deg))))
    mesh["overhang_mask"] = (nz < crit_cos).astype(np.float32)

    P = _get_process_param(process, "P_W", "power_W", "power")
    v = _get_process_param(process, "v_mm_per_s", "speed_mm_per_s", "scan_speed_mm_per_s", "speed")
    h = _get_process_param(process, "h_mm", "hatch_mm", "hatch_spacing_mm")
    t = _get_process_param(process, "t_mm", "layer_thickness_mm")

    ved = 0.0
    if P is not None and v is not None and h is not None and t is not None and v > 0 and h > 0 and t > 0:
        ved = float(P) / (float(v) * float(h) * float(t))
    mesh["VED_J_per_mm3"] = np.full(mesh.n_points, ved, dtype=np.float32)

    mesh.field_data["iter"] = np.array([int(it)], dtype=np.int32)
    mesh.field_data["iso_threshold"] = np.array([float(iso_threshold)], dtype=np.float32)
    mesh.field_data["voxel_size_mm"] = np.array([float(voxel_size_mm)], dtype=np.float32)

    out_path = out_dir / f"physics_manifest_iter_{int(it):06d}.vtp"
    tmp_path = out_dir / f".physics_manifest_iter_{int(it):06d}.{os.getpid()}.tmp.vtp"

    mesh.save(str(tmp_path))
    os.replace(tmp_path, out_path)
    return out_path


# -----------------------------
# Preview STL
# -----------------------------
def _theta_tensor_to_stl(theta: torch.Tensor, out_stl: Path, *, voxel_size_mm: float, level: float) -> None:
    import pyvista as pv

    a = _theta_to_numpy_grid(theta).astype(np.float32)
    nx, ny, nz = a.shape

    grid = pv.ImageData()
    grid.dimensions = (nx, ny, nz)
    grid.spacing = (voxel_size_mm, voxel_size_mm, voxel_size_mm)
    grid.origin = (0.0, 0.0, 0.0)
    grid.point_data["theta"] = a.ravel(order="F")

    surf = grid.contour(isosurfaces=1, rng=[float(level), float(level)], scalars="theta")
    if surf is None or surf.n_points == 0:
        raise RuntimeError(f"No surface extracted. Try lowering iso threshold (level={level}).")

    out_stl.parent.mkdir(parents=True, exist_ok=True)
    surf.save(str(out_stl))


def _progress_pct(last_iter: int, total_iters: int) -> float:
    if total_iters <= 0:
        return 0.0
    pct = (float(last_iter) / float(total_iters)) * 100.0
    return float(max(0.0, min(100.0, pct)))


def _health_status(run: Dict[str, Any]) -> str:
    if run.get("error_text"):
        return "ERROR"

    run_dir = run.get("run_dir")
    if run_dir:
        p = Path(str(run_dir)) / "logs" / "run_error.txt"
        try:
            if p.exists() and p.is_file() and p.stat().st_size > 0:
                return "ERROR"
        except Exception:
            pass

    try:
        warnings = run.get("warnings_json") or "[]"
        arr = json.loads(warnings) if isinstance(warnings, str) else warnings
        if isinstance(arr, list) and len(arr) > 0:
            return "WARN"
    except Exception:
        return "WARN"

    return "OK"


